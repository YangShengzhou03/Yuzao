{
  "name": "yuzao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tauri dev",
    "build-pro": "npm run build && npm run tauri build",
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "lint": "vue-tsc --noEmit --strict",
    "lint:rust": "cd src-tauri && cargo clippy -- -W clippy::all -W clippy::pedantic -W clippy::nursery -D warnings",
    "lint:all": "npm run lint && npm run lint:rust",
    "audit": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "clean": "node -e \"['node_modules','dist','src-tauri/target'].forEach(d=>{try{require('fs').rmSync(d,{recursive:true,force:true})}catch(e){}})\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "element-plus": "^2.14.7",
    "three": "^0.187.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
